# ============================================================
# 前端 Docker 开发模式环境变量（容器内执行 `vite --mode docker` 加载）
# 运行在 docker 网络 app-net 中：
#   - 页面由 web 容器（vite dev server，端口 80）托管
#   - API /dev-api 由 vite 代理转发到后端容器 backend:8080
# 本文件在源码绑定挂载内，改后重启 web 容器即生效，无需重建镜像。
# ============================================================

# 应用部署基础路径
VITE_BASE_URL = /

# API 请求基础路径（dev 走 /dev-api 前缀，由 vite 代理去掉）
VITE_API_URL = /dev-api

# 代理目标地址（docker 网络内后端容器服务名）
VITE_API_PROXY_URL = http://backend:8080

# vite dev server 端口（容器内，compose 映射到宿主机 80）
VITE_PORT = 80
